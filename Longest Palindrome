int longestPalindrome(char* s) {
    int freq[128] = {0};
    while (*s) {
        freq[(unsigned char)*s]++;
        s++;
    }
    
    int length = 0;
    int odd_found = 0;
    
    for (int i = 0; i < 128; i++) {
        length += (freq[i] / 2) * 2;
        if (freq[i] % 2 != 0) {
            odd_found = 1;
        }
    }
    
    return length + odd_found;
}
