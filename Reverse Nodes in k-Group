struct ListNode* reverseKGroup(struct ListNode* head, int k) {
    if (head == NULL || k == 1) return head;

    struct ListNode dummy;
    dummy.next = head;
    
    struct ListNode* pointerTracker = &dummy;

    while (pointerTracker != NULL) {
        struct ListNode* checker = pointerTracker;
        for (int i = 0; i < k; i++) {
            checker = checker->next;
            if (checker == NULL) {
                return dummy.next;
            }
        }

        struct ListNode* prev = pointerTracker->next;
        struct ListNode* current = prev->next;
        for (int i = 1; i < k; i++) {
            struct ListNode* nextNode = current->next;
            current->next = pointerTracker->next;
            pointerTracker->next = current;
            prev->next = nextNode;
            current = nextNode;
        }
        pointerTracker = prev;
    }

    return dummy.next;
}
