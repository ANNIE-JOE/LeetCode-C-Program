#include <stdlib.h>
#include <string.h>

char* countAndSay(int n) {
    if (n <= 0) return NULL;
    
    char* current = (char*)malloc(2 * sizeof(char));
    strcpy(current, "1");
    
    for (int i = 2; i <= n; i++) {
        int len = strlen(current);
        char* next_str = (char*)malloc((len * 2 + 1) * sizeof(char));
        int next_idx = 0;
        
        int j = 0;
        while (j < len) {
            int count = 1;
            while (j + 1 < len && current[j] == current[j + 1]) {
                count++;
                j++;
            }
            
            next_str[next_idx++] = count + '0';
            next_str[next_idx++] = current[j];
            j++;
        }
        next_str[next_idx] = '\0';
        
        free(current);
        current = next_str;
    }
    
    return current;
}
