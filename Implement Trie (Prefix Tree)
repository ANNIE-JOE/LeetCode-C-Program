#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

typedef struct Trie {
    struct Trie* children[26];
    bool isEndOfWord;
} Trie;

Trie* trieCreate() {
    Trie* obj = (Trie*)calloc(1, sizeof(Trie));
    return obj;
}

void trieInsert(Trie* obj, char* word) {
    Trie* curr = obj;
    int len = strlen(word);
    for (int i = 0; i < len; i++) {
        int idx = word[i] - 'a';
        if (curr->children[idx] == NULL) {
            curr->children[idx] = trieCreate();
        }
        curr = curr->children[idx];
    }
    curr->isEndOfWord = true;
}

bool trieSearch(Trie* obj, char* word) {
    Trie* curr = obj;
    int len = strlen(word);
    for (int i = 0; i < len; i++) {
        int idx = word[i] - 'a';
        if (curr->children[idx] == NULL) {
            return false;
        }
        curr = curr->children[idx];
    }
    return curr->isEndOfWord;
}

bool trieStartsWith(Trie* obj, char* prefix) {
    Trie* curr = obj;
    int len = strlen(prefix);
    for (int i = 0; i < len; i++) {
        int idx = prefix[i] - 'a';
        if (curr->children[idx] == NULL) {
            return false;
        }
        curr = curr->children[idx];
    }
    return true;
}

void trieFree(Trie* obj) {
    if (obj == NULL) return;
    for (int i = 0; i < 26; i++) {
        trieFree(obj->children[i]);
    }
    free(obj);
}
