bool isBadVersion(int version);

int firstBadVersion(int n) {
    long long left = 1;
    long long right = n;
    
    while (left < right) {
        long long mid = left + (right - left) / 2;
        if (isBadVersion((int)mid)) {
            right = mid; 
        } else {
            left = mid + 1; 
        }
    }
    
    return (int)left;
}
