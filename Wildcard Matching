#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

bool isMatch(char* s, char* p) {
    int sLen = strlen(s);
    int pLen = strlen(p);
    bool* prev = (bool*)calloc(pLen + 1, sizeof(bool));
    bool* curr = (bool*)calloc(pLen + 1, sizeof(bool));
    prev[0] = true;

    for (int j = 1; j <= pLen; j++) {
        if (p[j - 1] == '*') {
            prev[j] = prev[j - 1];
        } else {
            break;
        }
    }
    for (int i = 1; i <= sLen; i++) {
        curr[0] = false; 
        for (int j = 1; j <= pLen; j++) {
            if (p[j - 1] == s[i - 1] || p[j - 1] == '?') {
                curr[j] = prev[j - 1];
            } else if (p[j - 1] == '*') {
                curr[j] = curr[j - 1] || prev[j];
            } else {
                curr[j] = false;
            }
        }
        memcpy(prev, curr, (pLen + 1) * sizeof(bool));
    }

    bool result = prev[pLen];
    
    free(prev);
    free(curr);
    
    return result;
}
