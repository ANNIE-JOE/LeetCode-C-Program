#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

int ladderLength(char* beginWord, char* endWord, char** wordList, int wordListSize) {
    int endIdx = -1;
    for (int i = 0; i < wordListSize; i++) {
        if (strcmp(wordList[i], endWord) == 0) {
            endIdx = i;
            break;
        }
    }
    
    if (endIdx == -1) {
        return 0;
    }
    
    int totalWords = wordListSize + 1;
    char** allWords = (char**)malloc(totalWords * sizeof(char*));
    allWords[0] = beginWord;
    for (int i = 0; i < wordListSize; i++) {
        allWords[i + 1] = wordList[i];
    }
    
    int startNode = 0;
    int endNode = endIdx + 1;
    int wordLen = strlen(beginWord);
    
    bool* visited = (bool*)calloc(totalWords, sizeof(bool));
    int* queue = (int*)malloc(totalWords * sizeof(int));
    int head = 0, tail = 0;
    
    queue[tail++] = startNode;
    visited[startNode] = true;
    
    int depth = 1;
    
    while (head < tail) {
        int size = tail - head;
        for (int i = 0; i < size; i++) {
            int u = queue[head++];
            
            if (u == endNode) {
                free(allWords);
                free(visited);
                free(queue);
                return depth;
            }
            
            for (int v = 0; v < totalWords; v++) {
                if (visited[v]) continue;
                
                int diff = 0;
                for (int k = 0; k < wordLen; k++) {
                    if (allWords[u][k] != allWords[v][k]) {
                        diff++;
                        if (diff > 1) break;
                    }
                }
                
                if (diff == 1) {
                    visited[v] = true;
                    queue[tail++] = v;
                }
            }
        }
        depth++;
    }
    
    free(allWords);
    free(visited);
    free(queue);
    
    return 0;
}
