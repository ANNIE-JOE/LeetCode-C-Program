struct TreeNode* buildTreeHelper(int* preorder, int* preIdx, int* inorder, int inStart, int inEnd) {
    if (inStart > inEnd) {
        return NULL;
    }

    int rootVal = preorder[*preIdx];
    (*preIdx)++;

    struct TreeNode* root = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    root->val = rootVal;
    root->left = NULL;
    root->right = NULL;

    int rootInIdx = inStart;
    while (rootInIdx <= inEnd && inorder[rootInIdx] != rootVal) {
        rootInIdx++;
    }

    root->left = buildTreeHelper(preorder, preIdx, inorder, inStart, rootInIdx - 1);
    root->right = buildTreeHelper(preorder, preIdx, inorder, rootInIdx + 1, inEnd);

    return root;
}

struct TreeNode* buildTree(int* preorder, int preorderSize, int* inorder, int inorderSize) {
    int preIdx = 0;
    return buildTreeHelper(preorder, &preIdx, inorder, 0, inorderSize - 1);
}
